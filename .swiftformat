# Diamond Age Portfolio — SwiftFormat Configuration
--swiftversion 6.0
--indent 4
--indentcase true
--trimwhitespace always
--voidtype void
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--maxwidth 120
--funcattributes prev-line
--typeattributes prev-line
--varattributes prev-line
--self init-only
--importgrouping alpha
--commas always
--decimalgrouping 3
--binarygrouping 4,8
--octalgrouping 4,8
--hexgrouping 4,8
--semicolons never
--header strip
--ifdef no-indent
--redundanttype inferred
--emptybraces linebreak
--exclude config/linting,DerivedData,.build
